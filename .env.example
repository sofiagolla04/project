# Live mode only; demo works without these. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: transactional writes, invitations, private asset cleanup.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
# Supported structured-text default; configurable. No image understanding is required.
OPENAI_MODEL=gpt-4.1-mini
# Cloud editors that reserve OPENAI_* can use these server-only aliases instead:
HUP_AI_KEY=
HUP_AI_MODEL=
# Optional integration suite (disposable local Supabase ONLY)
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
